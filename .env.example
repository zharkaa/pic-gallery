# Copy this file to .env.local and fill in the values from your Supabase project.
# Dashboard -> Project Settings -> API (or Data API) -> Project URL / publishable key.
# The publishable key (`sb_publishable_...`) is the same client-side key that
# older projects call the "anon" key, so either works.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
